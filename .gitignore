# SPEC: NFR-SEC-01, NFR-LIC-03, AC-30
# Secrets and environment files
.env
.env.*
!.env.example

# Lessons are written for this course and committed (NFR-LIC-03, SPEC-013). Only the lesson lists,
# the lesson files and the language list are tracked; recorded audio is added at build time.
public-content/*
!public-content/index.json
!public-content/lessons/
public-content/lessons/*
!public-content/lessons/*.junior.json
!public-content/lessons/*.plain-english.json
!public-content/lessons/*.detailed.json
# SPEC-009: per-language content, the same files under lang/<code>/.
!public-content/languages.json
!public-content/lang/
public-content/lang/*
!public-content/lang/*/
public-content/lang/*/*
!public-content/lang/*/index.json
!public-content/lang/*/lessons/
public-content/lang/*/lessons/*
!public-content/lang/*/lessons/*.junior.json
!public-content/lang/*/lessons/*.plain-english.json
!public-content/lang/*/lessons/*.detailed.json
.narration-cache/

# Build artifacts and binaries (Rule 10, AC-30)
bin/
web/dist/
web/node_modules/

# Test and coverage artifacts
test-results/
playwright-report/
coverage.out
*.test

# OS metadata
.DS_Store
Thumbs.db

# IDE workspace files
*.code-workspace
.vscode/
.idea/

# Runtime files and logs
.app.pids
.web.pid
logs/
nohup.out
web/nohup.out
# Compiled server binary at the repo root only (not cmd/server/)
/server
web/*.tsbuildinfo

# Runtime state file for invite-only mode (SPEC-008)
/data/
# Terraform local state and provider cache
**/.terraform/
*.tfstate
*.tfstate.*
# Skill lookup data (dev tooling, not part of the app)
.claude/skills/*/data/
.claude/skills/*/scripts/data/
# Terraform inputs hold personal data (billing account, emails); the repo is public.
deploy/terraform/terraform.tfvars

# SPEC-011: large generated art masters stay out of git; the register records their checksums
design/brand/masters/
