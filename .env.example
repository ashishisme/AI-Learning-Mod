# SPEC: NFR-SEC-01
OPENAI_API_KEY=
GITHUB_TOKEN=
CONTENT_DIR=
PORT=
# Optional local LLM endpoint (e.g. Ollama http://localhost:11434/v1)
OPENAI_BASE_URL=
OPENAI_MODEL=
# Set to true only on a private local machine. Allows POST /api/ingest/sync (Settings > Sync Latest),
# which rewrites lesson content and can use GITHUB_TOKEN. Leave unset on any deployed server.
INGEST_SYNC_ENABLED=
# Set to true on any public deployment. AI endpoint, key and model then come only from this file /
# the platform's configuration; Settings overrides, curriculum sync and AI-config-test are disabled,
# and the server will not connect to private or metadata addresses.
HOSTED_MODE=
# Number of reverse proxies in front of the server (1 for Cloud Run), so rate limits count each visitor.
TRUSTED_PROXY_HOPS=

# --- SPEC-008: invite-only access, spend ceiling, admin console, feedback ---
# Where state lives: file (default; development, tests, self-hosting) or firestore (required on Cloud Run).
STATE_BACKEND=
# Project holding the Firestore database, with STATE_BACKEND=firestore. Credentials come from the runtime identity.
FIRESTORE_PROJECT_ID=
# Development and CI only: host:port of the Firestore emulator. Refused on Cloud Run.
FIRESTORE_EMULATOR_HOST=
# On Cloud Run secrets are mounted from Secret Manager and read from files; plain variables are refused.
SESSION_SECRET_FILE=
OIDC_CLIENT_SECRET_FILE=
FEEDBACK_AUDITOR_API_KEY_FILE=
# Both or neither: turn on the verified budget notification route (FR-026). Set by Terraform.
BUDGET_PUSH_AUDIENCE=
BUDGET_PUSH_SERVICE_ACCOUNT=
# Turn on invite-only sign-in for a non-hosted run (HOSTED_MODE=true always turns it on).
AUTH_REQUIRED=
# JSON state file (accounts, invites, sessions, audit, counters, feedback). Needs a persistent volume.
STATE_FILE=
# At least 32 random bytes, e.g. `head -c 32 /dev/urandom | base64`. Signs the admin session cookie.
SESSION_SECRET=
# Public URL of this server (used for invite links and the OIDC redirect), e.g. https://coach.example.org
PUBLIC_BASE_URL=
# Admin sign-in (OpenID Connect). MFA is enforced by your identity provider.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Also require the "mfa" value in the ID token's amr claim.
OIDC_REQUIRE_MFA=
# Comma-separated admin emails allowed into /admin.
ADMIN_EMAILS=
# Seat cap: accounts plus unused unexpired invites (default 1000).
SEAT_CAP=
# The AI tutor. Defaults to false when hosted (FR-024), true otherwise.
TUTOR_ENABLED=
# Shared daily AI spend ceiling in US dollars (default 1.00) and token prices per million tokens.
DAILY_SPEND_CEILING_USD=
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
# Monthly budget shown in the admin Costs tab (default 30).
MONTHLY_BUDGET_USD=
# Feedback is offered only when all three are set (the AI auditor that screens it).
FEEDBACK_AUDITOR_BASE_URL=
FEEDBACK_AUDITOR_API_KEY=
FEEDBACK_AUDITOR_MODEL=

